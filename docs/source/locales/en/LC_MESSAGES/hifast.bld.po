#: ../../hifast.bld.rst:2 c6dba947aa2f45f38b1098b07f4ff4b1
msgid "hifast.bld 扣除基线"
msgstr ""

#: ../../hifast.bld.rst:5 450eaad675684a068a42a47d72b93b92
msgid "``hifast.bld`` : 拟合并扣除基线(**b**\\ ase\\ **l**\\ ine\\ **d**)。"
msgstr ""

#: ../../hifast.bld.rst:7 d666981bfcc349b7950d2d68ef94eb31
msgid "示例"
msgstr ""

#: ../../hifast.bld.rst:13 ec540fc641f24f4c90a71bec73df6878
msgid ""
"输入 ``hifast.sep``\\ 产生的\\ ``specs_T.hdf5``\\ 文件或者\\ ``hifast.flux``\\ 产生的"
" \\ ``specs_T-flux.hdf5``\\ 文件来拟合和扣除基线， 也可以输入它自己生成的文件，进行二次去基线。"
msgstr ""

#: ../../hifast.bld.rst:17 8551d478f1ec444481ccb5718d124fc1
msgid "拟合前处理（处理后的谱线仅用于拟合基线，然后用 *原始谱线* 减去基线后保存到文件）"
msgstr ""

#: ../../hifast.bld.rst:19 f93b2b37a9454490b86acf6167a16aed
msgid "沿时间轴对每个 *channel* (*frequency sample*)操作， 使用于基线比较稳定，随时间变化小的情况。*谨慎使用*"
msgstr ""

#: ../../hifast.bld.rst:22 0cb66b63ec984815bd46a8669e5d095f
msgid "``--njoin``: 多少条谱线合并处理来拟合基线"
msgstr ""

#: ../../hifast.bld.rst:23 eabd5a229d70467998b9208c8712e3d0
msgid ""
"``--s_method_t``: 沿时间轴平滑的方法；可选 ``median``, ``gaussian``, ``boxcar``； "
"配合``--s_sigma_t``"
msgstr ""

#: ../../hifast.bld.rst:25 f9321a687f4f48d0b499e19f390f69ac
msgid "``--s_sigma_t``: 平滑尺度，单位为谱线数。"
msgstr ""

#: ../../hifast.bld.rst:27 81f029c3282c4c519f038bebfcd73475
msgid "沿频率轴对每条谱线"
msgstr ""

#: ../../hifast.bld.rst:29 516a70659c094af495b9243a87dbb408
msgid ""
"``--s_method_freq``: 每条谱线沿频率轴平滑以提高信噪比，可选 ``gaussian``, ``boxcar``； 配合 "
"``--s_sigma_freq``。"
msgstr ""

#: ../../hifast.bld.rst:31 effe199f97404abfb07e507b32ea576e
msgid "``--s_sigma_freq``: 平滑尺度，单位采样点的数量。一般W带可设为3, F和N带可设为48。"
msgstr ""

#: ../../hifast.bld.rst:34 e5e89bf9992a4085ac977ac2114eaf71
msgid "``--average_every_freq``: 沿频率轴每多少个点进行平均从而降低频率采样提高信噪比。"
msgstr ""

#: ../../hifast.bld.rst:36 e80ef34acf804ca5bd1f5c646fa9bfbb
msgid "拟合参数"
msgstr ""

#: ../../hifast.bld.rst:38 a81fd77fabaf4445ab67feb880d67ac3
msgid "``--method``: 拟合方法： ``arPLS``, ``srPLS``, ``Chebyshev``, ``poly``"
msgstr ""

#: ../../hifast.bld.rst:40 a5de6e5ac96847a2b1b0759f32b71de5
msgid "``arPLS``: 适合只有发射线的情况"
msgstr ""

#: ../../hifast.bld.rst:41 2196b66a2c7a48a8b13f3f54c6d617bd
msgid "``srPLS``: 适合发射线和吸收线，但是如果基线过于复杂则效果不好"
msgstr ""

#: ../../hifast.bld.rst:42 cd472f1b3dd54878b49b928796258aa7
msgid ""
"``Chebyshev, poly``: 为多项式拟合，适用于基线比较简单的情况，例如减去参考点(off-source)谱线后 "
"残余基线和连续谱的扣除。"
msgstr ""

#: ../../hifast.bld.rst:45 2f3cbf89aee646a8abeeb03d3aab3728
msgid "``--lam``: ``arPLS, srPLS`` 去基线时的参数，调整平滑度，越大越接近低阶多项式(poly)拟合。"
msgstr ""

#: ../../hifast.bld.rst:46 ce234719532e41468bddc3a19c033c60
msgid ""
"``--deg``: ``arPLS, srPLS`` 时取2即可；``Chebyshev, poly`` 时为多项式阶数，例如 ``--deg "
"1`` 为线性拟合。"
msgstr ""

#: ../../hifast.bld.rst:47 9be4c64ad8fb42248d7a86f860f39c64
msgid "``--niter``：迭代次数，用于排除“信号”区域来寻找基线。默认即可。"
msgstr ""

#: ../../hifast.bld.rst:48 c6c75db6f523490b8419f33d15156ea7
msgid "其他参数"
msgstr ""

#: ../../hifast.bld.rst:50 c7b94cf639f045a88cfbe8cba8647680
msgid "``--nproc``: 后接一个数，使用多少个进程来并行。"
msgstr ""

#: ../../hifast.bld.rst:52 99ca10314e7d4ba5bf7f49f910594fa6
msgid "``--frange``\\ ： 只用这个频率范围内谱线。后接两个数，空格隔开，下限在前。 范围越大，拟合用时越长，并且不是线性增长。"
msgstr ""

#: ../../hifast.bld.rst:58 b28bca10a8a24229bd60534a588bbfb6
msgid "输出文件名会包含\\ ``-bld``\\ 的hdf5文件。可以用h5py来读取。"
msgstr ""

#: ../../hifast.bld.rst:60 f0ea71cfe3da4de281bb8b4224c53377
msgid "**在JupyterLab中交互调参**"
msgstr ""

#: ../../hifast.bld.rst:62 18d384eac6a44eeabd5b3a1058964e45
msgid "``-i``: 执行交互模式"
msgstr ""

#: ../../hifast.bld.rst:63 3989f620aefb40a1bb0b8383557b19e2
msgid "``--length``: 每次用多少条谱线来测试，默认20"
msgstr ""

#: ../../hifast.bld.rst:64 362c81166f4946a0b521d7769531810f
msgid "``--figsize``: 输出图片大小，为matplotlib中的参数。"
msgstr ""

#: ../../hifast.bld.rst:66 e43fbe32c4c348b19eca0e95e5d60849
msgid "同时\\ ``--nproc``\\ 和\\ ``--frange``\\ 在这一模式中也支持."
msgstr ""

