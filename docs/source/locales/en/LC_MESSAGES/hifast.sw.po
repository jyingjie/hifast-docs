msgid "字符"
msgstr ""

#: ../../hifast.sw.rst:123 aeafe9d0464a4c298afd5961eabdbc70
msgid "驻波周期(MHz)"
msgstr ""

#: ../../hifast.sw.rst:125 d66e7e396ca84a71b63f432ee80c692b
msgid "1mhz"
msgstr ""

#: ../../hifast.sw.rst:125 abae36bf3f264f1dba72f96c23f4c73b
msgid "1.08"
msgstr ""

#: ../../hifast.sw.rst:126 efc40dbac3a244cb97b542120b924914
msgid "2mhz"
